{
  "info": {
    "name": "Gestão de Doações — IAP Joinville",
    "description": "Fluxos principais da API: login, campanhas, necessidades, doações, progresso e relatórios.\n\nRode as pastas em ordem (Runner do Postman ou newman). Cada requisição guarda os ids que as seguintes usam. Veja postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Datas no fuso do computador (o servidor usa o horário de Brasília).",
          "const agora = new Date();",
          "const dois = (n) => String(n).padStart(2, '0');",
          "const anoMes = `${agora.getFullYear()}-${dois(agora.getMonth() + 1)}`;",
          "pm.collectionVariables.set('hoje', `${anoMes}-${dois(agora.getDate())}`);",
          "pm.collectionVariables.set('inicioMes', `${anoMes}-01`);",
          "",
          "// CSRF: requisições que alteram dados devolvem o cookie XSRF-TOKEN no cabeçalho X-XSRF-TOKEN.",
          "if (pm.request.method !== 'GET') {",
          "  pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: pm.collectionVariables.get('xsrf') || '' });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// O token CSRF muda (por exemplo, depois do login); guarda sempre o mais recente.",
          "const token = pm.cookies.get('XSRF-TOKEN');",
          "if (token) {",
          "  pm.collectionVariables.set('xsrf', token);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "xsrf", "value": "" },
    { "key": "hoje", "value": "" },
    { "key": "inicioMes", "value": "" },
    { "key": "campanhaId", "value": "" },
    { "key": "arrozId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Obter token CSRF",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 e cookie XSRF-TOKEN', () => {",
                  "  pm.response.to.have.status(204);",
                  "  pm.expect(pm.cookies.has('XSRF-TOKEN')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/csrf" }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 e usuário ADMIN', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().papel).to.eql('ADMIN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminSenha}}\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Renovar token CSRF após login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/csrf" }
        },
        {
          "name": "Usuário atual",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 com o e-mail do login', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().email).to.eql(pm.variables.get('adminEmail'));",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        }
      ]
    },
    {
      "name": "2. Campanhas",
      "item": [
        {
          "name": "Criar campanha",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 em rascunho', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().status).to.eql('RASCUNHO');",
                  "});",
                  "pm.collectionVariables.set('campanhaId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Campanha Postman {{$timestamp}}\",\n  \"descricao\": \"Criada pela coleção Postman\",\n  \"dataInicio\": \"{{inicioMes}}\",\n  \"metaValor\": 200\n}"
            },
            "url": "{{baseUrl}}/api/campanhas"
          }
        },
        {
          "name": "Ativar campanha",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 e ATIVA', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ATIVA');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ATIVA\"\n}" },
            "url": "{{baseUrl}}/api/campanhas/{{campanhaId}}/status"
          }
        },
        {
          "name": "Buscar campanha",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 com a meta em R$', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().metaValor).to.eql(200);",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/campanhas/{{campanhaId}}" }
        },
        {
          "name": "Listar campanhas ativas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 e contém a campanha criada', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const ids = pm.response.json().itens.map((c) => c.id);",
                  "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('campanhaId')));",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/campanhas?status=ATIVA&tamanho=100" }
        }
      ]
    },
    {
      "name": "3. Necessidades",
      "item": [
        {
          "name": "Criar necessidade (Arroz 10 kg)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('arrozId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"item\": \"Arroz\",\n  \"unidade\": \"KG\",\n  \"quantidadeMeta\": 10\n}" },
            "url": "{{baseUrl}}/api/campanhas/{{campanhaId}}/necessidades"
          }
        },
        {
          "name": "Listar necessidades",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 com o Arroz', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().map((n) => n.item)).to.eql(['Arroz']);",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/campanhas/{{campanhaId}}/necessidades" }
        }
      ]
    },
    {
      "name": "4. Doações",
      "item": [
        {
          "name": "Registrar doação de itens (anônima)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201, anônima, 4 kg de Arroz', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const doacao = pm.response.json();",
                  "  pm.expect(doacao.doadorId).to.be.null;",
                  "  pm.expect(doacao.itens[0].item).to.eql('Arroz');",
                  "  pm.expect(doacao.itens[0].quantidade).to.eql(4);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campanhaId\": {{campanhaId}},\n  \"tipo\": \"ITEM\",\n  \"dataDoacao\": \"{{hoje}}\",\n  \"itens\": [{ \"necessidadeId\": {{arrozId}}, \"quantidade\": 4 }]\n}"
            },
            "url": "{{baseUrl}}/api/doacoes"
          }
        },
        {
          "name": "Registrar doação em dinheiro (PIX)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201, R$ 50 via PIX', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().valor).to.eql(50);",
                  "  pm.expect(pm.response.json().formaPagamento).to.eql('PIX');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"campanhaId\": {{campanhaId}},\n  \"tipo\": \"DINHEIRO\",\n  \"valor\": 50,\n  \"formaPagamento\": \"PIX\",\n  \"dataDoacao\": \"{{hoje}}\"\n}"
            },
            "url": "{{baseUrl}}/api/doacoes"
          }
        },
        {
          "name": "Listar doações da campanha",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 com as 2 doações', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().total).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/doacoes?campanhaId={{campanhaId}}" }
        }
      ]
    },
    {
      "name": "5. Progresso",
      "item": [
        {
          "name": "Progresso da campanha",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('meta × arrecadado × pendente e total em R$', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const p = pm.response.json();",
                  "  pm.expect(p.necessidades[0].arrecadado).to.eql(4);",
                  "  pm.expect(p.necessidades[0].pendente).to.eql(6);",
                  "  pm.expect(p.necessidades[0].percentual).to.eql(40);",
                  "  pm.expect(p.percentualGeral).to.eql(40);",
                  "  pm.expect(p.totalDinheiro).to.eql(50);",
                  "  pm.expect(p.percentualValor).to.eql(25);",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/campanhas/{{campanhaId}}/progresso" }
        },
        {
          "name": "Painel",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 e a campanha está entre as ativas', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const ids = pm.response.json().campanhasAtivas.map((c) => c.campanhaId);",
                  "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('campanhaId')));",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/painel" }
        }
      ]
    },
    {
      "name": "6. Relatórios",
      "item": [
        {
          "name": "Relatório da campanha (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 com as necessidades', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().necessidades).to.have.lengthOf(1);",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/relatorios/campanha/{{campanhaId}}" }
        },
        {
          "name": "Relatório da campanha (CSV)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSV com a linha do Arroz', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');",
                  "  pm.expect(pm.response.text()).to.include('Arroz;kg;10,00;4,00;6,00;0,00;40');",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/relatorios/campanha/{{campanhaId}}?formato=csv" }
        },
        {
          "name": "Relatório de doações do mês",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('2 doações e R$ 50', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().quantidade).to.eql(2);",
                  "  pm.expect(pm.response.json().totalDinheiro).to.eql(50);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/relatorios/doacoes?de={{inicioMes}}&ate={{hoje}}&campanhaId={{campanhaId}}"
          }
        },
        {
          "name": "Pendências (texto para WhatsApp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('texto com o que falta', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain');",
                  "  pm.expect(pm.response.text()).to.include('• Arroz: 6 kg');",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/relatorios/pendencias?campanhaId={{campanhaId}}" }
        }
      ]
    },
    {
      "name": "7. Encerramento",
      "item": [
        {
          "name": "Encerrar campanha de teste",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 e ENCERRADA', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ENCERRADA');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"ENCERRADA\"\n}" },
            "url": "{{baseUrl}}/api/campanhas/{{campanhaId}}/status"
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('204', () => pm.response.to.have.status(204));"]
              }
            }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" }
        },
        {
          "name": "Sem sessão a API responde 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/painel" }
        }
      ]
    }
  ]
}
